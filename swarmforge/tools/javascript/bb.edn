{:paths ["src" "test" "property" "../core/src" "../core/test"]
 :tasks
 {test {:doc "Run the sf-js unit tests"
        :task (let [namespaces '[sfjs.package-test sfjs.cli-test sfjs.commands-test sfjs.crap-test sfjs.mutate-test sfjs.reports-test sfjs.architecture-test]]
                (apply require 'clojure.test namespaces)
                (let [{:keys [fail error]} (apply clojure.test/run-tests namespaces)]
                  (System/exit (+ fail error))))}
  property {:doc "Run the property tests of sf-js and the shared core"
            :task (let [namespaces '[sfcore.core-property sfjs.sfjs-property]]
                    (apply require 'clojure.test namespaces)
                    (let [{:keys [fail error]} (apply clojure.test/run-tests namespaces)]
                      (System/exit (+ fail error))))}}}
