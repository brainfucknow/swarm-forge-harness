#!/usr/bin/env bash
# sf-rb: Ruby tool wrapper for SwarmForge roles. See swarmforge/languages/ruby.md.
set -euo pipefail
command -v bb >/dev/null || { echo "sf-rb: Babashka (bb) is required: https://babashka.org" >&2; exit 2; }
exec bb --config "$(cd "$(dirname "$0")/../tools/ruby" && pwd)/bb.edn" -m sfrb.cli "$@"
