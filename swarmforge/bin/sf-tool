#!/usr/bin/env bash
# sf-tool: install the constitution tools project-locally and wrap them with
# the constitution's argument guardrails. Catalogue: swarmforge/tools.conf.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: sf tool <command> [tool]

  require <tool>   print OK and the wrapper path, or MISSING (exit 1)
  ensure <tool>    install the tool and what it needs; write its wrapper
  list             print the catalogue
  bin              print the wrapper directory; put it on PATH

Wrappers live in .swarmforge/bin/ and sources in .swarmforge/tools/, both
under the repository root and ignored by git. SWARMFORGE_TOOL_SRC points every
GitHub source at one local checkout instead of cloning.
EOF
}

die() { echo "sf tool: $*" >&2; exit 1; }

repo_root() {
  local common
  common="$(git rev-parse --path-format=absolute --git-common-dir)"
  (cd "$common/.." && pwd)
}

catalogue() { grep -Ev '^\s*(#|$)' "$(repo_root)/swarmforge/tools.conf"; }

spec_of() {
  local tool="$1" line
  line="$(catalogue | awk -v t="$tool" '$1==t')"
  [ -n "$line" ] || die "unknown tool '$tool' (see swarmforge/tools.conf)"
  echo "$line"
}

bin_dir() { echo "$(repo_root)/.swarmforge/bin"; }

wrapper_path() { echo "$(bin_dir)/$1"; }

source_dir() {
  local source="$1"
  if [ -n "${SWARMFORGE_TOOL_SRC:-}" ]; then echo "$SWARMFORGE_TOOL_SRC"
  else echo "$(repo_root)/.swarmforge/tools/${source##*/}"
  fi
}

needs_of() {
  local needs="$1"
  [ "$needs" = "-" ] || echo "$needs" | tr ',' '\n'
}

cmd_require() {
  local tool="${1:-}"; [ -n "$tool" ] || die "require needs a tool"
  local line; line="$(spec_of "$tool")"
  local needs; needs="$(echo "$line" | awk '{print $6}')"
  local dep
  for dep in $(needs_of "$needs") "$tool"; do
    if [ ! -x "$(wrapper_path "$dep")" ]; then
      echo "MISSING: $dep"
      echo "Run: sf tool ensure $dep"
      exit 1
    fi
  done
  echo "OK: $tool $(wrapper_path "$tool")"
}

ensure_source() {
  local source="$1" dir
  dir="$(source_dir "$source")"
  if [ ! -f "$dir/bb.edn" ]; then
    [ -z "${SWARMFORGE_TOOL_SRC:-}" ] || die "SWARMFORGE_TOOL_SRC has no bb.edn: $dir"
    mkdir -p "$(dirname "$dir")"
    git clone --quiet --depth 1 "https://$source.git" "$dir" || die "failed to clone https://$source.git"
  fi
  echo "$dir"
}

rewrite_mutate() {
  cat <<'EOF'
args=()
scan=
while [ $# -gt 0 ]; do
  case "$1" in
    --mutate-all) shift ;;
    --scan|--update-manifest) scan=1; args+=("$1"); shift ;;
    --max-workers) shift; [ $# -gt 0 ] && shift ;;
    *) args+=("$1"); shift ;;
  esac
done
[ -n "$scan" ] || args+=(--max-workers 4)
set -- "${args[@]}"
EOF
}

rewrite_gherkin() {
  cat <<'EOF'
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --level)
      if [ "${2:-}" = full ]; then args+=(--level hard); else args+=("$1" "${2:-}"); fi
      shift; [ $# -gt 0 ] && shift ;;
    --workers) shift; [ $# -gt 0 ] && shift ;;
    *) args+=("$1"); shift ;;
  esac
done
args+=(--workers 4)
set -- "${args[@]}"
EOF
}

rewrite_for() {
  case "$1" in
    mutate) rewrite_mutate ;;
    gherkin) rewrite_gherkin ;;
    -) ;;
    *) die "unknown rewrite '$1' in swarmforge/tools.conf" ;;
  esac
}

sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

clj_command() {
  local tool="$1" coordinate="$2" main="$3"
  case "$tool" in
    cloverage)
      echo "exec clojure -Sdeps $(sq '{:paths ["src" "spec" "test"] :deps {cloverage/cloverage {:mvn/version "RELEASE"} speclj/speclj {:mvn/version "3.13.0"}}}') -M -m $main -p src -s spec -s test -r speclj \"\$@\"" ;;
    speclj)
      echo "exec clojure -Sdeps $(sq '{:paths ["src" "spec" "test"] :deps {speclj/speclj {:mvn/version "3.13.0"}}}') -M -m $main -c spec \"\$@\"" ;;
    *)
      echo "exec clojure -Sdeps $(sq "{:deps {$coordinate {:mvn/version \"RELEASE\"}}}") -M -m $main \"\$@\"" ;;
  esac
}

write_wrapper() {
  local tool="$1" rewrite="$2" command="$3" path
  path="$(wrapper_path "$tool")"
  mkdir -p "$(dirname "$path")"
  {
    echo '#!/usr/bin/env bash'
    rewrite_for "$rewrite"
    echo "$command"
  } > "$path"
  chmod 755 "$path"
  echo "INSTALLED: $tool $path"
}

install_one() {
  local tool="$1" line kind source task rewrite
  line="$(spec_of "$tool")"
  read -r _ kind source task rewrite _ <<< "$line"
  case "$kind" in
    bb)
      local dir; dir="$(ensure_source "$source")"
      write_wrapper "$tool" "$rewrite" "exec bb --config $(sq "$dir/bb.edn") $task \"\$@\"" ;;
    clj)
      write_wrapper "$tool" "$rewrite" "$(clj_command "$tool" "$source" "$task")" ;;
    local)
      write_wrapper "$tool" "$rewrite" "exec $(sq "$(repo_root)/$source") \"\$@\"" ;;
    *) die "unknown kind '$kind' for $tool" ;;
  esac
}

cmd_ensure() {
  local tool="${1:-}"; [ -n "$tool" ] || die "ensure needs a tool"
  local line; line="$(spec_of "$tool")"
  local dep
  for dep in $(needs_of "$(echo "$line" | awk '{print $6}')"); do
    cmd_ensure "$dep"
  done
  install_one "$tool"
}

cmd_list() { catalogue | awk '{printf "%-22s %-5s %s\n", $1, $2, $3}'; }

main() {
  local cmd="${1:-}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    require) cmd_require "$@" ;;
    ensure) cmd_ensure "$@" ;;
    list) cmd_list ;;
    bin) bin_dir ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command '$cmd'" ;;
  esac
}

main "$@"
